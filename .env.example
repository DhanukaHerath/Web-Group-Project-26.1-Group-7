# ========================================================
# NSBM ArtCraft - Environment Configuration
# ========================================================

# Application Configuration
APP_NAME="NSBM ArtCraft"
APP_ENV=development
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=*

# Database Connection
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nsbm_artcraft
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_SSL_CA=
DB_SSL_VERIFY=false

# File Upload Settings
UPLOAD_DIR=uploads/
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Session & Security
SESSION_LIFETIME=604800

# Initial Administrator Credentials (Configurable - No Hardcoded Values)
INITIAL_ADMIN_USERNAME=admin_artcraft
INITIAL_ADMIN_EMAIL=admin@nsbm.ac.lk
INITIAL_ADMIN_PASSWORD=Admin@123
INITIAL_ADMIN_NAME="NSBM ArtCraft Administrator"
